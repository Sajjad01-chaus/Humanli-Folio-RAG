# Copy to .env and set your key locally. Keep .env out of version control.
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
# sentence-transformers: local semantic embeddings. First run downloads ~90 MB.
# tfidf: lightweight lexical fallback; explicitly identified in responses/UI.
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_LOCAL_ONLY=false
DATA_DIR=data
LLM_TIMEOUT=60
# Optional shared access token for non-local deployment. Local demo is single-user.
APP_ACCESS_TOKEN=
RERANK_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Bounded corrective retrieval + claim verification. Extra calls use provider quota.
ADAPTIVE_RETRIEVAL=true
VERIFY_GROUNDING=true
# Optional scanned-page OCR; requires pypdfium2, Tesseract and its English language pack.
OCR_ENABLED=false
TESSERACT_CMD=tesseract
# I pace requests within one process; set these limits for your Groq account.
PROVIDER_TOKENS_PER_MINUTE=8000
MAX_INPUT_TOKENS=5500
